# Public variables embedded in the Vite client bundle.
# Set these in Vercel for Preview, Production and Development as appropriate.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
VITE_PAYPAL_CLIENT_ID=

# Do not add passwords, service-role keys, Stripe secret keys, or any other
# credential to a VITE_* variable. Keep those server-side (e.g. Supabase Edge
# Function secrets) only.
